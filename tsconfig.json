{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/extension/src/**/*.ts",
    "apps/sync-worker/src/**/*.ts"
  ]
}
