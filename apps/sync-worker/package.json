{
  "name": "xfeed-sync-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:local": "node dev-server.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute xfeed-sync --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute xfeed-sync --remote --file=./schema.sql"
  }
}
