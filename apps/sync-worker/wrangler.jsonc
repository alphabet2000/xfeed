{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xfeed-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xfeed-sync",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
